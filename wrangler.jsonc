{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mechpro-api",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  // Pages owns the www hostname. Keep this Worker route-only so deploy does
  // not fight the Pages custom domain.
  "workers_dev": false,
  "routes": [
    {
      "pattern": "www.yourcarguy806.com/api/*",
      "zone_name": "yourcarguy806.com"
    }
  ],
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "ALLOWED_ORIGINS": "https://www.yourcarguy806.com,https://mechpro-dispatch.pages.dev",
    "PAGES_ORIGIN": "https://mechpro-dispatch.pages.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mechpro",
      "database_id": "aa5434b8-9fe9-44ed-8e98-8f5b40bb2c26",
      "migrations_dir": "worker/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "mechpro-files",
      "preview_bucket_name": "mechpro-files-preview"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
