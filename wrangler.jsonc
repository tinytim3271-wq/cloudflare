{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mechpro-api",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  // The Worker serves /api/* and proxies the shop app from Pages.
  "workers_dev": false,
  "vars": {
    // Conversational AI: Anthropic answers when ANTHROPIC_API_KEY is set as a secret;
    // otherwise the Workers AI binding below keeps the assistant connected.
    "AI_ENABLED": "1",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "ANTHROPIC_SONNET_MODEL": "claude-sonnet-5",
    "ANTHROPIC_OPUS_MODEL": "claude-opus-5",
    "DEEPGRAM_LISTEN_MODEL": "nova-3",
    "DEEPGRAM_SPEAK_MODEL": "flux-kit-en",
    "ALLOWED_ORIGINS": "https://www.yourcarguy806.com,https://mechpro-dispatch.pages.dev",
    "PAGES_ORIGIN": "https://mechpro-dispatch.pages.dev",
    "AUTH_EMAIL_FROM": "noreply@yourcarguy806.com"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@yourcarguy806.com"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mechpro",
      "database_id": "aa5434b8-9fe9-44ed-8e98-8f5b40bb2c26",
      "migrations_dir": "worker/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "mechpro-files",
      "preview_bucket_name": "mechpro-files-preview"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AI_CHAT_SESSIONS",
        "class_name": "AiChatSession"
      },
      {
        "name": "AI_VOICE_SESSIONS",
        "class_name": "AiVoiceSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-ai-voice-sessions",
      "new_sqlite_classes": ["AiVoiceSession"]
    },
    {
      "tag": "v2-ai-chat-sessions",
      "new_sqlite_classes": ["AiChatSession"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
