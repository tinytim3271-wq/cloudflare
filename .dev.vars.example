# Local Worker secrets for `wrangler dev` (copy to `.dev.vars` — gitignored).
# Never enable DEV_AUTH_BYPASS in production.

DEV_AUTH_BYPASS=1
ACCESS_ADMIN_EMAILS=admin@example.com
INTEGRATION_ENCRYPTION_KEY=replace-with-a-long-random-value
DIAGNOSTICS_CAPABILITY_SECRET=replace-with-a-different-random-value
# Base64 DER PKCS#8 ECDSA P-256 private key for /api/diagnostics/authorize
DIAGNOSTICS_SIGNING_PRIVATE_KEY=replace-with-base64-pkcs8-p256-private-key

# Conversational AI (keep AI_ENABLED=0 until both provider secrets are set).
AI_ENABLED=0
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
DEEPGRAM_API_KEY=replace-with-your-deepgram-api-key

# Configure current contracted provider rates before enabling pass-through billing.
# ANTHROPIC_SONNET_INPUT_USD_PER_MTOK=
# ANTHROPIC_SONNET_OUTPUT_USD_PER_MTOK=
# ANTHROPIC_OPUS_INPUT_USD_PER_MTOK=
# ANTHROPIC_OPUS_OUTPUT_USD_PER_MTOK=
# DEEPGRAM_VOICE_USD_PER_MINUTE=
# AI_BILLING_MARKUP_MULTIPLIER=1

# Optional Access simulation when not using DEV_AUTH_BYPASS:
# ACCESS_TEAM_DOMAIN=https://example.cloudflareaccess.com
# ACCESS_AUD=your-access-application-audience

# Magic-link email delivery. Production sender:
# https://www.yourcarguy806.com/api/auth/send-login
# These local settings are not uploaded by a Worker deployment.
# AUTH_EMAIL_FROM=noreply@yourcarguy806.com
# AUTH_EMAIL_WEBHOOK=https://www.yourcarguy806.com/api/auth/send-login
# AUTH_EMAIL_WEBHOOK_SECRET=replace-with-your-webhook-bearer-secret

# Google OpenID Connect. Register this local callback in Google Cloud:
# http://127.0.0.1:8787/api/auth/google/callback
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret

# PartsTech / MOTOR labor (per-shop credentials are stored encrypted in D1;
# these optional overrides are only for local stubbing of the API base URL).
# PARTSTECH_API_BASE=https://api.partstech.com

# QuickBooks Online OAuth app (Intuit Developer). Per-shop tokens are encrypted in D1.
# Register redirect: https://www.yourcarguy806.com/api/integrations/quickbooks/callback
# (local: http://127.0.0.1:8787/api/integrations/quickbooks/callback — the SPA posts code/state/realmId)
# QUICKBOOKS_CLIENT_ID=replace-with-intuit-client-id
# QUICKBOOKS_CLIENT_SECRET=replace-with-intuit-client-secret
# QUICKBOOKS_REDIRECT_URI=http://127.0.0.1:8787/qbo/callback
# QUICKBOOKS_SANDBOX=1
